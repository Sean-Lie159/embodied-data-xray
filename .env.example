# OpenAI 兼容接口：填你用的模型服务商的密钥
OPENAI_API_KEY=sk-在这里填你的密钥

# 接口地址：DeepSeek 填 https://api.deepseek.com
# Kimi 填 https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名，按服务商改：deepseek-chat / kimi-k2-0711-preview / gpt-4o-mini
DEFAULT_MODEL=deepseek-v4-flash

DEFAULT_TEMPERATURE=0.2

# 主表装载行数上限（安全阀，可选）：单表行数超过此阈值时截断，返回同时含
# rows_total/rows_loaded 并明确提示。默认值 500000，使常规采集数据不被静默截断。
# MAX_ROWS_IN_CONTEXT=500000

# ---- 可选：上下文预算（防 input length too long / HTTP 400）----
# 模型上下文窗口（token）。留空/0 = 按内置模型表推定，认不出按 256K 兜底
# （以 HY3 为基准）。**换模型时建议显式填写**——内置表可能过时，且兜底值
# 对小上下文模型不安全。参考值：hy3=262144（256K）、deepseek-v4=1048576（1M）、
# deepseek-v3/chat=131072（128K）、kimi（K2-0905 起）=262144。
# CONTEXT_WINDOW_TOKENS=262144
# 上下文可用比例（其余留给 system prompt / 本轮输入 / 模型输出）。
# CONTEXT_BUDGET_RATIO=0.6
# 自动压缩开关：超阈值时自动压缩历史（关闭后仅能手动触发，不保证不爆）。
# HISTORY_COMPACTION_ENABLED=true

# ---- 可选：Token 成本估算（美元/百万 token）----
# 两项都配置时，CLI/UI 会追加估算成本（如 ≈$0.0021）；未配置（留空/0）则不显示成本。
# 价格是易变信息，请按你所用模型服务商的**当前**定价填写，不要照抄示例数字。
# PRICE_INPUT_PER_MTOK=0.14      # 例：DeepSeek 输入 ¥2/百万 token（按汇率折算美元）
# PRICE_OUTPUT_PER_MTOK=0.28

# ---- 可选：实例部署模式（局域网共享给同事，docs/实例部署模式设计.md）----
# 开启后 UI 隐藏"模型设置"面板（模型配置由部署者在此 .env 预设，访问者不可见
# 不可改）；未配置完成时访问者只看到"联系部署者"提示。克隆用户默认关闭。
# INSTANCE_MODE=0
# 可选访问口令：非空时局域网访问者需先输入口令（简单门禁，内网明文，仅限可信网络）。
# ACCESS_PASSWORD=