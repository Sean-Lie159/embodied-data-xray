# OpenAI 兼容接口：填你用的模型服务商的密钥
OPENAI_API_KEY=sk-在这里填你的密钥

# 接口地址：DeepSeek 填 https://api.deepseek.com
# Kimi 填 https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名，按服务商改：deepseek-chat / kimi-k2-0711-preview / gpt-4o-mini
DEFAULT_MODEL=deepseek-v4-flash

DEFAULT_TEMPERATURE=0.2

# 主表装载行数上限（安全阀，可选）：单表行数超过此阈值时截断，返回同时含
# rows_total/rows_loaded 并明确提示。默认值 500000，使常规采集数据不被静默截断。
# MAX_ROWS_IN_CONTEXT=500000

# ---- 可选：Token 成本估算（美元/百万 token）----
# 两项都配置时，CLI/UI 会追加估算成本（如 ≈$0.0021）；未配置（留空/0）则不显示成本。
# 价格是易变信息，请按你所用模型服务商的**当前**定价填写，不要照抄示例数字。
# PRICE_INPUT_PER_MTOK=0.14      # 例：DeepSeek 输入 ¥2/百万 token（按汇率折算美元）
# PRICE_OUTPUT_PER_MTOK=0.28